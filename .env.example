# Better Auth configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth & Drive credentials (Server)
# Ensure both the Google Drive API and Google Picker API are enabled in Google Cloud Console
# within the SAME Google Cloud OAuth project.
GOOGLE_CLIENT_ID=your_project_number-your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH_PROXY_SECRET=your_oauth_proxy_secret_here

# Client-side configuration
# Public Google Client ID (mirrored from above for browser flows)
VITE_GOOGLE_CLIENT_ID=your_project_number-your_client_id.apps.googleusercontent.com

# Google Picker API Configuration (Optional)
# VITE_GOOGLE_PICKER_APP_ID is your Google Cloud project number (the numeric prefix before the hyphen in GOOGLE_CLIENT_ID).
# If omitted, it will be automatically inferred from the prefix of VITE_GOOGLE_CLIENT_ID.
VITE_GOOGLE_PICKER_APP_ID=your_cloud_project_number

# Google Picker API Key (Required for opening existing Drive files)
# In Google Cloud Console:
# 1. Enable "Google Picker API" and "Google Drive API" under the same project.
# 2. Create an API Key under Credentials.
# 3. Restrict the API key:
#    - API restrictions: Restrict key to "Google Picker API".
#    - Application restrictions (HTTP referrers / origins):
#        Local: http://localhost:3000/*
#        Production: https://concept.maddock.world/*
#        Picker iframe: https://docs.google.com/*
#        These are API-key website restrictions, separate from OAuth JavaScript origins.
VITE_GOOGLE_PICKER_API_KEY=your_google_picker_api_key_here
