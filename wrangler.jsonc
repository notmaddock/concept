{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concept",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "previews": {},
}
