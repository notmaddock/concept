{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concept",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "concept.maddock.world",
      "custom_domain": true,
      "previews_enabled": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://concept.maddock.world",
    "GOOGLE_CLIENT_ID": "819574860574-2pfteub2q3vuct13dpkm2vs7mug04rd1.apps.googleusercontent.com",
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "auth_db_prod",
      "database_id": "2b007185-6a01-45fc-942a-85b51af23837",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DRIVE_SAVES", "class_name": "DriveSaveCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1-drive-saves", "new_sqlite_classes": ["DriveSaveCoordinator"] },
  ],
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
    "issues": {
      "enabled": true,
    },
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_SECRET"],
  },
  "previews": {
    "vars": {
      "BETTER_AUTH_URL": "https://staging.concept.maddock.world",
      "GOOGLE_CLIENT_ID": "819574860574-3e68a16ekd85g25uj9jliejt4l2qaamp.apps.googleusercontent.com",
    },
    "d1_databases": [
      {
        "binding": "AUTH_DB",
        "database_name": "auth_db_preview",
        "database_id": "6ebb8d62-bf58-4ff1-8c3e-98a8c4d14455",
        "migrations_dir": "migrations",
      },
    ],
  },
}
