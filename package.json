{
  "name": "concept",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "pnpm run build && wrangler dev",
    "lint": "eslint . --max-warnings 0",
    "format": "eslint --fix && prettier --write .",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "wrangler": "wrangler",
    "deploy": "pnpm run build && pnpm run db:migrate:production && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate:production": "wrangler d1 migrations apply AUTH_DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply AUTH_DB --remote --config wrangler.preview-migrations.jsonc",
    "deploy:preview": "pnpm exec vite build --mode staging && pnpm run db:migrate:preview && wrangler preview --worker-name concept --name staging",
    "test": "vitest run",
    "validate": "pnpm run check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.12",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lexical/code": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/history": "^0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/yjs": "^0.52.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.3",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lexical": "^0.52.0",
    "lib0": "^0.2.119",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
