{
  "name": "concept",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "pnpm run build && wrangler dev",
    "lint": "eslint . --max-warnings 0",
    "format": "eslint --fix && prettier --write .",
    "check": "prettier --check .",
    "check:routes": "pnpm run generate-routes && git diff --exit-code src/routeTree.gen.ts",
    "check:types": "pnpm run cf-typegen && git diff --exit-code worker-configuration.d.ts",
    "check:cf-typegen": "pnpm run check:types",
    "typecheck": "tsc --noEmit",
    "wrangler": "wrangler",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false",
    "test": "vitest run",
    "validate": "pnpm run check && pnpm run check:routes && pnpm run check:types && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lexical/code": "^0.53.0",
    "@lexical/extension": "^0.53.0",
    "@lexical/history": "^0.53.0",
    "@lexical/html": "0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/yjs": "^0.53.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "1.7.16",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lexical": "^0.53.0",
    "lib0": "^0.2.119",
    "lucide-react": "^1.68.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.445.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
