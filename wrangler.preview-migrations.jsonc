{
  "$schema": "node_modules/wrangler/config-schema.json",
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "DocumentRealtimeDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocumentRealtimeDO"],
    },
  ],
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      "database_name": "concept-staging",
      "database_id": "e2f41d8f-17d9-46bf-b174-ea17dfe710a6",
      "migrations_dir": "migrations",
    },
  ],
}
